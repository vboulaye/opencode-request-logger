{
  "name": "opencode-request-logger",
  "version": "0.2.0",
  "type": "module",
  "description": "OpenCode plugin that logs raw LLM fetch request bodies to disk",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "clean": "rm -rf dist",
    "build": "bun run clean && tsc",
    "test": "bun run build && bun test"
  },
  "dependencies": {
    "@opencode/plugin": "^2.2.3"
  },
  "devDependencies": {
    "@types/node": "^25.1.0",
    "typescript": "^5.9.3"
  }
}
